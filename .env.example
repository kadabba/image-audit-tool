# Скопируйте в .env и задайте свои значения:
#   cp .env.example .env
#
# Файл .env в .gitignore и в репозиторий не попадает.

# Пароль БД. Обязателен — docker compose не стартует без него.
# Для прода сгенерируйте случайный: openssl rand -base64 32
DB_PASSWORD=change-me

# Необязательные, значения по умолчанию подходят для большинства случаев.
DB_USER=postgres
DB_NAME=image_audit

# Сколько дней хранить сканы, потом они удаляются. 0 отключает уборку.
RETENTION_DAYS=2

# Swagger по пути /docs. На публичном домене ставьте false.
ENABLE_DOCS=true

# Порт на 127.0.0.1, куда проксирует веб-сервер. Меняйте, если 8000 занят.
APP_PORT=8000
